# Copy this file to .env before starting the local stack.
# Keep .env local and never commit real credentials.

# Application
ENVIRONMENT=develop
DEBUG=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
SECRET_KEY=unsafe-local-development-key
ALLOWED_HOSTS=*
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost
EXTRA_AUTHENTICATION_BACKENDS=country_workspace.security.backends.AnyUserAuthBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOGGING_LEVEL=WARNING
APP_BASE_URL=http://host.docker.internal:8001/

# Database
POSTGRES_USER=hcw
POSTGRES_PASSWORD=password
POSTGRES_DB=country_workspace
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis / Celery
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/9
CELERY_TASK_ALWAYS_EAGER=False
CELERY_VISIBILITY_TIMEOUT=10800

# Storage
MEDIA_ROOT=/var/country_workspace/media
STATIC_ROOT=/var/country_workspace/static
FILE_STORAGE_HOPE=storages.backends.azure_storage.AzureStorage?azure_container=hope&overwrite_files=True&connection_string=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
FILE_STORAGE_MEDIA=storages.backends.azure_storage.AzureStorage?azure_container=media&overwrite_files=True&connection_string=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
INIT_HOPE_STORAGE=1

# RabbitMQ / streaming
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
STREAMING_BROKER_URL=rabbit://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/?vhost=/&exchange=django-streaming-broadcast

# HOPE
# Set the target instance and token when using this integration.
HOPE_API_URL=
HOPE_API_TOKEN=

# Dedup Engine
DEDUP_API_URL=http://host.docker.internal:8000/
DEDUP_API_TOKEN=

# Aurora
AURORA_API_URL=
AURORA_API_TOKEN=

# Kobo
KOBO_API_TOKEN=
KOBO_KF_URL=
KOBO_MASTER_API_TOKEN=
KOBO_PROJECT_VIEW_ID=

# Host ports
BACKEND_PORT=8001
BACKEND_DEBUG_PORT=5680
CELERY_DEBUG_PORT=5681
POSTGRES_PORT=5433
REDIS_PORT=6380
FLOWER_PORT=5556
AZURITE_PORT=10010
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
